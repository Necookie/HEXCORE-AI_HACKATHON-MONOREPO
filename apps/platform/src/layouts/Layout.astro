---
import '../styles/platform.css';
import Sidebar from '../components/Sidebar';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "The automated study pipeline." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title} | StudyBearer</title>
    <meta name="description" content={description} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
  </head>
  <body class="platform-body">
    <!-- Cinematic Noise Overlay -->
    <div class="noise-overlay"></div>
    
    <div class="dashboard-layout">
      <Sidebar client:load />
      
      <main id="main-content" class="dashboard-content">
        <slot />
      </main>
    </div>
    
    <style is:global>
      /* Global transitions and micro-interactions */
      * {
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }
      
      ::selection {
        background: var(--neon-indigo);
        color: white;
      }
    </style>
  </body>
</html>
