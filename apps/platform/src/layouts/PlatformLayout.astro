---
// PlatformLayout.astro – Persistent shell for all platform pages.
// Handles auth guard: if no session cookie, redirect to landing login.
import { createServerClient } from '@supabase/ssr';
import '../styles/global.css';

const supabase = createServerClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  {
    cookies: {
      getAll: () => {
        // Fallback to manual parsing if Astro.cookies.getAll is not a function
        if (typeof Astro.cookies.getAll === 'function') {
          return Astro.cookies.getAll().map(c => ({ name: c.name, value: c.value }));
        }
        const cookieHeader = Astro.request.headers.get('cookie') ?? '';
        return cookieHeader.split(';').map(c => {
          const [name, ...value] = c.trim().split('=');
          return { name, value: value.join('=') };
        }).filter(c => c.name !== '');
      },
      setAll: (cookies) => cookies.forEach(({ name, value, options }) =>
        Astro.cookies.set(name, value, options)),
    },
  }
);

const { data: { user } } = await supabase.auth.getUser();
if (!user) {
  return Astro.redirect('http://localhost:4321/?auth=login', 302);
}

interface Props {
  title?: string;
}
const { title = 'StudyBearer' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="StudyBearer – Your AI-powered learning roadmap platform." />
    <title>{title} | StudyBearer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-black text-slate-50">
    <!-- ── HEADER ── -->
    <header class="sticky top-0 z-40 flex items-center justify-between px-6 py-4 border-b border-cyan-400/15 bg-black/80 backdrop-blur-md">
      <!-- Logo -->
      <a href="/platform" class="flex items-center gap-2 group">
        <span class="inline-block w-7 h-7 rounded-md bg-cyan-400 group-hover:shadow-[0_0_16px_rgba(34,211,238,0.6)] transition-shadow duration-300">
          <!-- Simple 'S' glyph -->
          <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <text x="5" y="21" font-family="Inter,sans-serif" font-weight="700" font-size="18" fill="#000">S</text>
          </svg>
        </span>
        <span class="text-base font-semibold tracking-tight text-slate-50 group-hover:text-cyan-400 transition-colors duration-200">
          StudyBearer
        </span>
      </a>

      <!-- Sign Out -->
      <form action="/api/auth/signout" method="POST">
        <button
          type="submit"
          class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-400 border border-slate-700 rounded-lg hover:border-cyan-400/50 hover:text-slate-100 transition-all duration-200 group"
          aria-label="Sign out of StudyBearer"
        >
          <!-- LogOut icon (inline SVG mirrors lucide-react LogOut) -->
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="group-hover:text-cyan-400 transition-colors">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          Sign Out
        </button>
      </form>
    </header>

    <!-- ── PAGE CONTENT ── -->
    <main>
      <slot />
    </main>
  </body>
</html>
