---
import '../styles/global.css';
import sbLogo from '../assets/sb_symbol_blk.png';
import { ClientRouter } from 'astro:transitions';

interface Props { title?: string; }
const { title = 'StudyBearer' } = Astro.props;

const user = Astro.locals.user;
const userName  = user?.user_metadata?.full_name ?? user?.email?.split('@')[0] ?? 'Scholar';
const userEmail = user?.email ?? '';
const avatarSeed = encodeURIComponent(userEmail || userName);
const avatarUrl  = `https://api.dicebear.com/9.x/bottts-neutral/svg?seed=${avatarSeed}`;

const path = Astro.url.pathname;

const iconPaths: Record<string, string[]> = {
  home:    ['M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z','M9 22V12h6v10'],
  upload:  ['M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4','M17 8l-5-5-5 5','M12 3v12'],
  map:     ['M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z','M9 3v15','M15 6v15'],
  quiz:    ['M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z','M9 9a3 3 0 015.83 1c0 2-3 3-3 3','M12 17h.01'],
  trophy:  ['M6 9H4.5a2.5 2.5 0 000 5H6','M18 9h1.5a2.5 2.5 0 010 5H18','M4 2h16v7a8 8 0 01-16 0z','M12 17v5','M8 22h8'],
  flame:   ['M8.5 14.5A2.5 2.5 0 0011 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 11-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 002.5 2.5z'],
  zap:     ['M13 2L3 14h9l-1 8 10-12h-9z'],
  medal:   ['M12 15a7 7 0 100-14 7 7 0 000 14z','M8.21 13.89L7 23l5-3 5 3-1.21-9.12'],
  settings:['M12 15a3 3 0 100-6 3 3 0 000 6z','M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z'],
};

function icon(name: string, size = 17, color = 'currentColor') {
  const paths = iconPaths[name] ?? [];
  const pathsHtml = paths.map(d => `<path d="${d}"/>`).join('');
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">${pathsHtml}</svg>`;
}

function isActive(href: string) {
  if (href === '/platform') return path === '/platform';
  return path.startsWith(href);
}

const navDefs = [
  { href: '/platform/dashboard',    label: 'Dashboard',    iconName: 'home',   badge: '' },
  { href: '/platform',              label: 'New Subject',  iconName: 'upload', badge: '' },
  { href: '/platform/roadmap',      label: 'Roadmap',      iconName: 'map',    badge: '' },
  { href: '/platform/quiz',         label: 'Quiz',         iconName: 'quiz',   badge: '1' },
  { href: '/platform/achievements', label: 'Achievements', iconName: 'trophy', badge: '' },
];

// Build nav HTML as a string to avoid JSX + template-literal parser issues
const navHtml = navDefs.map(item => {
  const on = isActive(item.href);
  const color = on ? '#9D82FF' : 'var(--text-secondary)';
  const bg = on ? 'rgba(123,92,245,0.12)' : 'transparent';
  const border = on ? '1px solid rgba(123,92,245,0.4)' : '1px solid transparent';
  const borderLeft = on ? '3px solid var(--purple)' : '3px solid transparent';
  const pl = on ? '9px' : '12px';
  const fw = on ? '600' : '500';
  const cls = on ? 'sidebar-nav-link' : 'nav-btn sidebar-nav-link';
  const style = `display:flex;align-items:center;gap:11px;padding:8px ${pl};border-radius:var(--radius-md);text-decoration:none;border:${border};border-left:${borderLeft};font-family:var(--font-body);font-weight:${fw};font-size:13px;background:${bg};color:${color};transition:all 0.15s ease;`;
  const badgeHtml = item.badge ? `<span class="sb-nav-label" style="margin-left:auto;background:rgba(245,107,107,0.2);color:#F56B6B;border-radius:99px;padding:1px 7px;font-size:11px;font-weight:700;">${item.badge}</span>` : '';
  return `<a href="${item.href}" class="${cls}" data-label="${item.label}" style="${style}">${icon(item.iconName, 17, color)}<span class="sb-nav-label">${item.label}</span>${badgeHtml}</a>`;
}).join('');
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | StudyBearer</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <link href="https://db.onlinewebfonts.com/c/14936bb7a4b6575fd2eee80a3ab52cc2?family=Feather+Bold" rel="stylesheet" />
  <ClientRouter />
  <!-- Apply saved theme BEFORE first paint to avoid flash -->
  <script is:inline>
    (function () {
      var t = localStorage.getItem('sb-theme');
      if (t === 'light') document.documentElement.dataset.theme = 'light';
    })();
  </script>
</head>

<body>
  <div style="display:flex;height:100vh;width:100vw;overflow:hidden;background:var(--bg-base);">

    <!-- SIDEBAR WRAPPER (position:relative so the tab can escape overflow:hidden) -->
    <div transition:persist="sidebar" style="position:relative;display:flex;flex-shrink:0;z-index:20;">
      <!-- Toggle tab — sibling of aside so it isn't clipped -->
      <button id="sidebar-toggle" aria-label="Toggle sidebar" class="no-3d" style="position:absolute;right:-14px;top:50%;transform:translateY(-50%);width:14px;height:40px;background:var(--bg-elevated);border:1px solid var(--border);border-left:none;border-radius:0 6px 6px 0;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text-muted);padding:0;z-index:31;">
        <svg id="sb-toggle-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>

    <!-- SIDEBAR -->
    <aside id="sidebar" class="sidebar" style="background:var(--bg-card);border-right:1px solid var(--border);display:flex;flex-direction:column;height:100vh;flex-shrink:0;">

      <!-- Logo -->
      <div class="sb-logo-wrap" style="padding:16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:11px;">
        <img src={sbLogo.src} width="36" height="36" alt="StudyBearer" style="filter:invert(1);object-fit:contain;flex-shrink:0;" />
        <div class="sb-nav-label" style="flex:1;min-width:0;">
          <div style="font-family:var(--font-heading);font-weight:700;font-size:17px;letter-spacing:-0.025em;color:var(--text-primary);line-height:1.1;">StudyBearer</div>
          <div style="font-size:11px;color:var(--text-secondary);margin-top:1px;line-height:1.1;">AI Study Companion</div>
        </div>
      </div>

      <!-- Streak / ELO strip -->
      <div class="sb-streak" style="margin:10px 12px 4px;background:rgba(240,160,48,0.08);border:1px solid rgba(240,160,48,0.2);border-radius:var(--radius-md);padding:9px 12px;display:flex;align-items:center;gap:10px;">
        <Fragment set:html={icon('flame', 18, '#F0A030')} />
        <div class="sb-nav-label">
          <div style="font-family:var(--font-mono);font-weight:700;font-size:20px;color:#F0A030;line-height:1;">0</div>
          <div style="font-size:11px;color:var(--text-secondary);margin-top:2px;">Day Streak</div>
        </div>
        <div class="sb-nav-label" style="margin-left:auto;text-align:right;">
          <div style="font-family:var(--font-mono);font-size:14px;color:#60A5FA;font-weight:700;">0</div>
          <div style="font-size:11px;color:var(--text-secondary);">ELO</div>
        </div>
      </div>

      <!-- Nav (pre-rendered as HTML string to avoid JSX parser issues) -->
      <nav style="flex:1;padding:6px 8px;display:flex;flex-direction:column;gap:3px;">
        <Fragment set:html={navHtml} />
      </nav>

      <!-- User footer -->
      <div class="sb-user-wrap" style="padding:10px 12px;border-top:1px solid var(--border);display:flex;align-items:center;gap:10px;">
        <!-- Avatar -->
        <div id="sb-avatar" style="width:34px;height:34px;border-radius:50%;background:var(--bg-elevated);overflow:hidden;flex-shrink:0;border:2px solid rgba(157,130,255,0.3);cursor:pointer;user-select:none;">
          <img src={avatarUrl} alt={userName} width="34" height="34" style="width:100%;height:100%;object-fit:cover;display:block;" />
        </div>
        <!-- Name + email -->
        <div class="sb-nav-label" style="flex:1;min-width:0;">
          <div style="font-family:var(--font-heading);font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text-primary);line-height:1.25;">{userName}</div>
          <div style="font-size:11px;color:var(--text-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3;margin-top:1px;">{userEmail}</div>
        </div>
        <!-- Cog trigger -->
        <button id="sb-user-menu-trigger" class="no-3d sb-nav-label" aria-label="User settings" style="background:none;border:1px solid var(--border);border-radius:var(--radius-sm);padding:5px;cursor:pointer;color:var(--text-muted);display:flex;align-items:center;justify-content:center;transition:color 0.15s,border-color 0.15s,background 0.15s;flex-shrink:0;">
          <Fragment set:html={icon('settings', 14, 'currentColor')} />
        </button>
      </div>
    </aside>
    <script>
      // Runs synchronously before first paint — prevents the expand→collapse flash on navigation
      (function () {
        if (localStorage.getItem('sb-sidebar-collapsed') !== 'true') return;
        var sb   = document.getElementById('sidebar');
        var icon = document.getElementById('sb-toggle-icon');
        if (sb)   { sb.style.transition = 'none'; sb.classList.add('collapsed'); }
        if (icon) { icon.classList.add('rotated'); }
        // Re-enable transition after two frames so the initial state is painted without animation
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            if (sb) sb.style.transition = '';
          });
        });
      })();
    </script>
      <!-- User settings popup — inside persist so it survives ClientRouter navigations -->
      <div id="sb-user-popup" aria-hidden="true" style="
        position:fixed;
        z-index:9999;
        width:224px;
        background:var(--bg-elevated);
        border:1px solid var(--border);
        border-radius:var(--radius-lg);
        box-shadow:0 8px 32px rgba(0,0,0,0.5),0 2px 8px rgba(0,0,0,0.3);
        padding:6px;
        opacity:0;
        transform:translateY(8px) scale(0.97);
        pointer-events:none;
        transition:opacity 0.18s ease,transform 0.18s ease;
        transform-origin:bottom left;
      ">
        <!-- Identity block -->
        <div style="padding:10px 12px 8px;border-bottom:1px solid var(--border);margin-bottom:4px;">
          <div style="display:flex;align-items:center;gap:9px;">
            <div style="width:32px;height:32px;border-radius:50%;background:var(--bg-elevated);overflow:hidden;flex-shrink:0;border:2px solid rgba(157,130,255,0.3);">
              <img src={avatarUrl} alt={userName} width="32" height="32" style="width:100%;height:100%;object-fit:cover;display:block;" />
            </div>
            <div style="min-width:0;">
              <div style="font-family:var(--font-heading);font-size:12px;font-weight:700;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{userName}</div>
              <div style="font-size:11px;color:var(--text-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px;">{userEmail}</div>
            </div>
          </div>
        </div>
        <!-- Menu items -->
        <a href="/platform/profile" class="sb-popup-item">
          <Fragment set:html={icon('settings', 15, 'currentColor')} />
          <span>Profile &amp; Settings</span>
        </a>
        <a href="https://sb.necookie.dev" target="_blank" rel="noopener" class="sb-popup-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          <span>About StudyBearer</span>
        </a>
        <!-- Theme toggle -->
        <button id="sb-theme-toggle" class="sb-popup-item no-3d" style="width:100%;background:none;border:none;cursor:pointer;justify-content:space-between;font-family:var(--font-body);">
          <div style="display:flex;align-items:center;gap:9px;">
            <!-- Sun icon (light mode) -->
            <svg id="sb-theme-icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;display:none;"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <!-- Moon icon (dark mode) -->
            <svg id="sb-theme-icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            <span id="sb-theme-label">Light mode</span>
          </div>
          <!-- Toggle pill -->
          <div id="sb-theme-track" style="width:34px;height:20px;border-radius:99px;background:var(--border);position:relative;transition:background 0.22s ease;flex-shrink:0;">
            <div id="sb-theme-thumb" style="width:16px;height:16px;border-radius:50%;background:#fff;position:absolute;top:2px;left:2px;transition:transform 0.22s ease;box-shadow:0 1px 4px rgba(0,0,0,0.3);"></div>
          </div>
        </button>
        <div style="height:1px;background:var(--border);margin:4px 0;"></div>
        <button id="sb-signout-btn" class="sb-popup-item sb-popup-danger no-3d" style="width:100%;background:none;border:none;cursor:pointer;font-family:var(--font-body);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Sign out</span>
        </button>
      </div>
    </div><!-- end sidebar wrapper -->

    <!-- Purple hairline -->
    <div style="width:1px;background:rgba(123,92,245,0.3);flex-shrink:0;"></div>

    <!-- MAIN CONTENT -->
    <main style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
      <div style="flex:1;overflow:hidden;display:flex;">
        <slot />
      </div>
    </main>

  </div>
  <script>
    const sidebar = document.getElementById('sidebar');
    const toggle = document.getElementById('sidebar-toggle');
    const toggleIcon = document.getElementById('sb-toggle-icon');

    toggle?.addEventListener('click', () => {
      const collapsed = sidebar?.classList.toggle('collapsed') ?? false;
      toggleIcon?.classList.toggle('rotated', collapsed);
      localStorage.setItem('sb-sidebar-collapsed', String(collapsed));
    });

    // Nav tooltips — fixed-position so overflow:hidden doesn't clip them
    const tip = document.createElement('div');
    tip.style.cssText = [
      'position:fixed',
      'background:var(--bg-elevated)',
      'border:1px solid var(--border)',
      'color:var(--text-primary)',
      'padding:5px 11px',
      'border-radius:8px',
      'font-size:12px',
      'font-weight:500',
      'font-family:var(--font-body)',
      'white-space:nowrap',
      'pointer-events:none',
      'opacity:0',
      'transition:opacity 0.15s ease',
      'z-index:9999',
      'box-shadow:0 4px 16px rgba(0,0,0,0.4)',
    ].join(';');
    document.body.appendChild(tip);

    function setupNavLinks() {
      document.querySelectorAll('.sidebar-nav-link').forEach(link => {
        // Tooltip on hover (collapsed mode)
        link.addEventListener('mouseenter', () => {
          if (!sidebar?.classList.contains('collapsed')) return;
          const label = link.getAttribute('data-label');
          if (!label) return;
          const rect = link.getBoundingClientRect();
          tip.textContent = label;
          tip.style.left = (rect.right + 10) + 'px';
          tip.style.top  = (rect.top + rect.height / 2) + 'px';
          tip.style.transform = 'translateY(-50%)';
          tip.style.opacity = '1';
        });
        link.addEventListener('mouseleave', () => { tip.style.opacity = '0'; });
      });
    }

    function updateNavActive() {
      const path = window.location.pathname;
      document.querySelectorAll('.sidebar-nav-link').forEach(link => {
        const href = link.getAttribute('href') ?? '';
        const active = href === '/platform' ? path === '/platform' : path.startsWith(href);
        const svg = link.querySelector('svg');

        if (active) {
          link.style.color      = '#9D82FF';
          link.style.background = 'rgba(123,92,245,0.12)';
          link.style.border     = '1px solid rgba(123,92,245,0.4)';
          link.style.borderLeft = '3px solid var(--purple)';
          link.style.fontWeight = '600';
          link.style.paddingLeft = '9px';
          link.style.boxShadow  = 'none';
          link.classList.remove('nav-btn');
          if (svg) svg.setAttribute('stroke', '#9D82FF');
        } else {
          link.style.color      = 'var(--text-secondary)';
          link.style.background = 'transparent';
          link.style.border     = '1px solid transparent';
          link.style.borderLeft = '3px solid transparent';
          link.style.fontWeight = '500';
          link.style.paddingLeft = '12px';
          link.style.boxShadow  = 'none';
          link.classList.add('nav-btn');
          if (svg) svg.setAttribute('stroke', 'var(--text-secondary)');
        }
      });
    }

    setupNavLinks();
    updateNavActive();
    document.addEventListener('astro:page-load', updateNavActive);

    // ── User settings popup ────────────────────────────────────────────────
    const popup   = document.getElementById('sb-user-popup');
    const trigger = document.getElementById('sb-user-menu-trigger');
    const avatar  = document.getElementById('sb-avatar');

    function positionPopup() {
      const ref = sidebar?.classList.contains('collapsed') ? avatar : trigger;
      if (!ref || !popup) return;
      const rect = ref.getBoundingClientRect();
      // Position above the trigger, aligned to its left edge
      popup.style.left   = rect.left + 'px';
      popup.style.bottom = (window.innerHeight - rect.top + 8) + 'px';
      popup.style.top    = 'auto';
    }

    function openPopup() {
      positionPopup();
      popup?.classList.add('open');
      popup?.setAttribute('aria-hidden', 'false');
      trigger?.classList.add('active');
    }

    function closePopup() {
      popup?.classList.remove('open');
      popup?.setAttribute('aria-hidden', 'true');
      trigger?.classList.remove('active');
    }

    function togglePopup() {
      popup?.classList.contains('open') ? closePopup() : openPopup();
    }

    trigger?.addEventListener('click', (e) => { e.stopPropagation(); togglePopup(); });
    // In collapsed mode, clicking the avatar also opens popup
    avatar?.addEventListener('click', (e) => {
      if (sidebar?.classList.contains('collapsed')) { e.stopPropagation(); togglePopup(); }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (popup?.classList.contains('open') && !popup.contains(e.target as Node)) {
        closePopup();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePopup();
    });

    // Reposition on resize
    window.addEventListener('resize', () => {
      if (popup?.classList.contains('open')) positionPopup();
    });

    // ── Theme toggle ─────────────────────────────────────────────────────
    function syncThemeToggle() {
      const isLight = document.documentElement.dataset.theme === 'light';
      const track   = document.getElementById('sb-theme-track');
      const thumb   = document.getElementById('sb-theme-thumb');
      const label   = document.getElementById('sb-theme-label');
      const sun     = document.getElementById('sb-theme-icon-sun');
      const moon    = document.getElementById('sb-theme-icon-moon');

      if (track)  track.style.background = isLight ? 'var(--purple)' : 'var(--border)';
      if (thumb)  thumb.style.transform  = isLight ? 'translateX(14px)' : 'translateX(0)';
      if (label)  label.textContent      = isLight ? 'Dark mode'  : 'Light mode';
      if (sun)    sun.style.display      = isLight ? 'block' : 'none';
      if (moon)   moon.style.display     = isLight ? 'none'  : 'block';
    }

    function setupThemeToggle() {
      syncThemeToggle();
      document.getElementById('sb-theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        if (next === 'dark') {
          delete document.documentElement.dataset.theme;
        } else {
          document.documentElement.dataset.theme = 'light';
        }
        localStorage.setItem('sb-theme', next);
        syncThemeToggle();
      });
    }
    setupThemeToggle();
    document.addEventListener('astro:page-load', setupThemeToggle);

    // ── Sign out ─────────────────────────────────────────────────────────
    // Must call signOut() on the BROWSER client so Supabase clears its
    // localStorage tokens before we redirect. If we only clear cookies
    // server-side, getSession() on landing reads the stale localStorage
    // access token and immediately redirects back to platform.
    import { createClient } from '@supabase/supabase-js';
    const _supa = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    );

    function setupSignout() {
      document.getElementById('sb-signout-btn')?.addEventListener('click', async () => {
        // 1. Sign out client-side — clears localStorage tokens
        await _supa.auth.signOut().catch(() => {});
        // 2. Also clear server-side cookies via API endpoint
        await fetch('/api/auth/signout', { method: 'POST' }).catch(() => {});
        // 3. Redirect to landing (no ?so=1 needed — localStorage already empty)
        const isLocal = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
        window.location.replace(isLocal ? 'http://localhost:4321' : 'https://sb.necookie.dev');
      });
    }
    setupSignout();
    document.addEventListener('astro:page-load', setupSignout);
  </script>
</body>
</html>
