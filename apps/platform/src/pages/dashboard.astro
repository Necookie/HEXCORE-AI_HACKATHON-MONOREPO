---
import Layout from '../layouts/Layout.astro';
import { 
  Trophy, 
  Zap, 
  Activity, 
  Lock, 
  CheckCircle2, 
  Play,
  Terminal,
  Cpu
} from 'lucide-react';
---

<Layout title="Dashboard">
  <div class="max-w-6xl mx-auto">
    <!-- Terminal Header -->
    <header class="mb-12 relative">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center border border-primary/20 shadow-neon">
          <Terminal size={20} className="text-primary" />
        </div>
        <div class="h-[1px] flex-1 bg-gradient-to-r from-primary/30 to-transparent"></div>
      </div>
      
      <h1 class="text-6xl font-black tracking-tighter text-white mb-2">
        WELCOME BACK, <span class="text-gradient uppercase">Student</span>
      </h1>
      <p class="text-muted-steel font-mono text-sm flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
        SYSTEM_READY // PIPELINE_ACTIVE_NODE: MODULE_02
      </p>
    </header>

    <!-- Status Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      <!-- Streak Card -->
      <div class="terminal-card group">
        <div class="card-glow"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-6">
            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-muted-steel">Current Streak</span>
            <Zap size={16} className="text-primary group-hover:fill-primary transition-all" />
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-5xl font-black text-white">5</span>
            <span class="text-lg font-bold text-muted-steel">DAYS</span>
          </div>
          <div class="mt-6 flex gap-1">
            {[1, 2, 3, 4, 5].map(() => (
              <div class="h-1 flex-1 bg-primary shadow-neon rounded-full"></div>
            ))}
            <div class="h-1 flex-1 bg-white/5 rounded-full"></div>
            <div class="h-1 flex-1 bg-white/5 rounded-full"></div>
          </div>
        </div>
      </div>

      <!-- Elo Card -->
      <div class="terminal-card group">
        <div class="card-glow"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-6">
            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-muted-steel">Elo Rating</span>
            <Activity size={16} className="text-violet-arc" />
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-5xl font-black text-white">1240</span>
            <span class="text-[10px] font-bold px-2 py-1 bg-violet-arc/10 text-violet-arc rounded border border-violet-arc/20 uppercase tracking-widest">Silver</span>
          </div>
          <p class="mt-4 text-[10px] font-mono text-muted-steel uppercase tracking-tight">Top 15% of Study Bearers</p>
        </div>
      </div>

      <!-- Rank Progress Card -->
      <div class="terminal-card group">
        <div class="card-glow"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-6">
            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-muted-steel">Next Rank Progress</span>
            <Trophy size={16} className="text-yellow-500" />
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-5xl font-black text-white">82</span>
            <span class="text-lg font-bold text-muted-steel">%</span>
          </div>
          <div class="mt-6 h-1.5 w-full bg-white/5 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-primary to-violet-arc shadow-neon" style="width: 82%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pipeline Timeline -->
    <section class="relative">
      <div class="flex items-center gap-4 mb-10">
        <Cpu size={18} className="text-primary" />
        <h2 class="text-sm font-bold uppercase tracking-[0.3em] text-white">Today's Pipeline</h2>
        <div class="h-[1px] flex-1 bg-white/5"></div>
      </div>

      <div class="space-y-8 relative before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-[2px] before:bg-white/5">
        
        <!-- COMPLETED ITEM -->
        <div class="flex gap-8 group">
          <div class="relative z-10 flex-shrink-0 w-6 h-6 rounded-full bg-black border-2 border-white/10 flex items-center justify-center">
            <CheckCircle2 size={12} className="text-green-500/50" />
          </div>
          <div class="flex-1 pb-8 border-b border-white/5">
            <div class="flex justify-between items-start opacity-40">
              <div>
                <span class="text-[10px] font-mono text-muted-steel uppercase tracking-tighter">09:00 - 10:30 // COMPLETED</span>
                <h3 class="text-xl font-bold text-muted-steel line-through tracking-tight mt-1">Advanced Discrete Mathematics: Graph Theory</h3>
                <p class="text-xs text-muted-steel/60 mt-1 font-medium italic">"The foundations of complex networking structures."</p>
              </div>
              <div class="text-[10px] font-bold text-green-500 uppercase tracking-widest border border-green-500/20 px-2 py-1 rounded bg-green-500/5">
                Archived
              </div>
            </div>
          </div>
        </div>

        <!-- ACTIVE ITEM -->
        <div class="flex gap-8 group">
          <div class="relative z-10 flex-shrink-0 w-6 h-6 rounded-full bg-black border-2 border-primary shadow-neon flex items-center justify-center">
            <div class="w-1.5 h-1.5 bg-primary rounded-full animate-pulse shadow-neon"></div>
          </div>
          <div class="flex-1 pb-8 border-b border-white/5">
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
              <div class="flex-1">
                <span class="text-[10px] font-mono text-primary uppercase tracking-tighter animate-pulse">14:00 - 15:30 // ACTIVE_MODULE</span>
                <h3 class="text-2xl font-black text-white tracking-tight mt-1 flex items-center gap-3">
                  Neural Network Architectures: Transformer Blocks
                  <span class="text-[10px] font-bold bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 rounded">HIGH_INTENSITY</span>
                </h3>
                <p class="text-sm text-muted-steel mt-2 max-w-2xl leading-relaxed">
                  Focusing on Multi-Head Attention mechanisms, positional encoding, and self-attention weight distribution.
                </p>
              </div>
              <button class="execute-button group/btn">
                <div class="button-glow"></div>
                <Play size={14} fill="currentColor" className="relative z-10 group-hover/btn:translate-x-0.5 transition-transform" />
                <span class="relative z-10">EXECUTE MODULE</span>
              </button>
            </div>
          </div>
        </div>

        <!-- LOCKED ITEM -->
        <div class="flex gap-8 group opacity-60">
          <div class="relative z-10 flex-shrink-0 w-6 h-6 rounded-full bg-black border-2 border-white/5 flex items-center justify-center">
            <Lock size={12} className="text-muted-steel/40" />
          </div>
          <div class="flex-1">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-[10px] font-mono text-muted-steel/50 uppercase tracking-tighter">17:00 - 18:30 // QUEUED</span>
                <h3 class="text-xl font-bold text-muted-steel tracking-tight mt-1">Stochastic Processes: Markov Chains</h3>
                <div class="flex gap-2 mt-3">
                  <div class="w-20 h-1 bg-white/5 rounded-full overflow-hidden">
                    <div class="h-full bg-white/20" style="width: 0%"></div>
                  </div>
                  <span class="text-[10px] font-mono text-muted-steel/30 uppercase">Prerequisites required</span>
                </div>
              </div>
              <Lock size={16} className="text-muted-steel/20" />
            </div>
          </div>
        </div>

      </div>
    </section>
  </div>
</Layout>

<style>
  .terminal-card {
    @apply relative bg-[#050505] border border-white/5 p-8 rounded-2xl overflow-hidden transition-all duration-500 backdrop-blur-xl;
  }

  .terminal-card:hover {
    @apply border-white/10 -translate-y-1;
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.5);
  }

  .card-glow {
    @apply absolute -inset-[100%] bg-gradient-to-tr from-transparent via-white/[0.03] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-1000 rotate-45;
  }

  .execute-button {
    @apply relative flex items-center gap-3 bg-white text-black px-8 py-4 rounded-xl font-black text-xs tracking-widest transition-all duration-300 hover:scale-105 active:scale-95;
  }

  .button-glow {
    @apply absolute inset-0 bg-white blur-md opacity-20 group-hover/btn:opacity-40 transition-opacity;
  }

  .text-gradient {
    background: linear-gradient(180deg, #ffffff 0%, #a1a1aa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .shadow-neon {
    box-shadow: 0 0 15px var(--neon-indigo);
  }
</style>
