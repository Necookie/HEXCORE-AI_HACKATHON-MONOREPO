---
// /auth/callback — handles cross-domain login and email confirmation
import { createServerClient, parseCookieHeader } from "@supabase/ssr";

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

if (!supabaseUrl || !supabaseKey) {
    return new Response("Server configuration error: Supabase keys missing.", { status: 500 });
}

const supabase = createServerClient(
  supabaseUrl,
  supabaseKey,
  {
    cookies: {
      getAll: () => {
        // Bulletproof way to get cookies on Cloudflare: parse the header directly
        return parseCookieHeader(Astro.request.headers.get("Cookie") ?? "");
      },
      setAll: (cookies) => {
        // Standard Astro way to set cookies
        cookies.forEach(({ name, value, options }) =>
          Astro.cookies.set(name, value, options)
        );
      },
    },
  }
);

const code = Astro.url.searchParams.get("code");
const accessToken = Astro.url.searchParams.get("access_token");
const refreshToken = Astro.url.searchParams.get("refresh_token");

try {
    if (code) {
      const { error } = await supabase.auth.exchangeCodeForSession(code);
      if (error) throw error;
      return Astro.redirect("/platform");
    } else if (accessToken && refreshToken) {
      const { error } = await supabase.auth.setSession({
        access_token: accessToken,
        refresh_token: refreshToken,
      });
      if (error) throw error;
      return Astro.redirect("/platform");
    }
} catch (e: any) {
    console.error("Auth error:", e.message);
    return new Response(`Auth Error: ${e.message}`, { status: 500 });
}

return Astro.redirect("/");
---
