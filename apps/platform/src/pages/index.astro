---
import Layout from '../layouts/Layout.astro';
import { supabaseClient } from '../lib/supabase';

const supabase = supabaseClient(Astro.cookies);

// Attempt to get user, but don't force redirect for this UI demo task
const { data: { user } } = await supabase.auth.getUser();

// We'll use 'Student 1' as a fallback if not logged in for the sake of the design request
const displayName = user?.user_metadata?.full_name || 'Student 1';
---

<Layout title="Dashboard">
  <header class="content-header">
    <h1 class="text-gradient">Welcome back, {displayName}</h1>
    <p>The pipeline is active. Next cognitive module starts in 2 hours.</p>
  </header>

  <section class="dashboard-grid">
    <div class="card">
      <h3>Current Streak</h3>
      <div class="streak-value">5 Days</div>
      <p class="muted">2 sessions until next Rank Up.</p>
    </div>

    <div class="card">
      <h3>Elo Rating</h3>
      <div class="elo-value">1,240 <span class="tier">Silver III</span></div>
      <div class="progress-bar">
        <div class="progress-fill" style="width: 65%;"></div>
      </div>
    </div>

    <div class="card wide">
      <h3>Active Pipeline</h3>
      <div class="pipeline-list">
        <div class="pipeline-item completed">
          <div class="status-dot"></div>
          <div class="item-info">
            <span class="time">09:00 UTC</span>
            <span class="label">Advanced Algorithms: Recursion Patterns</span>
          </div>
        </div>
        <div class="pipeline-item active">
          <div class="status-dot"></div>
          <div class="item-info">
            <span class="time">14:00 UTC</span>
            <span class="label">System Architecture: Load Balancing & Scaling</span>
          </div>
          <button class="btn-execute">EXECUTE MODULE</button>
        </div>
        <div class="pipeline-item">
          <div class="status-dot"></div>
          <div class="item-info">
            <span class="time">17:30 UTC</span>
            <span class="label">Database Optimization: Indexing Strategies</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .content-header {
    margin-bottom: 3.5rem;
  }

  .content-header h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    font-weight: 800;
  }

  .content-header p {
    color: var(--muted-steel);
    font-size: 1.1rem;
    max-width: 600px;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 1000px;
  }

  .card {
    background: linear-gradient(145deg, rgba(18, 18, 22, 0.8) 0%, rgba(10, 10, 12, 0.8) 100%);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 2rem;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .card.wide {
    grid-column: span 2;
  }

  .card h3 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted-steel);
    margin-bottom: 2rem;
    font-weight: 700;
  }

  .streak-value, .elo-value {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .tier {
    font-size: 1.1rem;
    color: var(--neon-indigo);
    font-weight: 600;
    margin-left: 0.5rem;
  }

  .progress-bar {
    height: 4px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    margin-top: 1.5rem;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--neon-indigo), var(--violet-arc));
    box-shadow: 0 0 15px rgba(99, 102, 241, 0.5);
  }

  .pipeline-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pipeline-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.03);
    transition: all 0.3s ease;
  }

  .pipeline-item:hover {
    background: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.06);
  }

  .pipeline-item.active {
    border-color: rgba(99, 102, 241, 0.2);
    background: rgba(99, 102, 241, 0.02);
    box-shadow: inset 0 0 20px rgba(99, 102, 241, 0.03);
  }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #27272a;
    flex-shrink: 0;
  }

  .completed .status-dot {
    background: #10b981;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.4);
  }

  .active .status-dot {
    background: var(--neon-indigo);
    box-shadow: 0 0 12px rgba(99, 102, 241, 0.6);
    animation: pulse-neon 2s infinite;
  }

  @keyframes pulse-neon {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.7; }
    100% { transform: scale(1); opacity: 1; }
  }

  .item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--muted-steel);
    font-weight: 500;
  }

  .label {
    font-weight: 600;
    font-size: 1rem;
  }

  .completed .label {
    text-decoration: line-through;
    color: var(--muted-steel);
    opacity: 0.6;
  }

  .btn-execute {
    background: var(--neon-indigo);
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2);
  }

  .btn-execute:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
    background: #4f46e5;
  }

  .muted {
    color: var(--muted-steel);
    font-size: 0.95rem;
  }

  .text-gradient {
    background: linear-gradient(180deg, #ffffff 0%, #a1a1aa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
