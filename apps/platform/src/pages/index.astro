---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { supabaseClient } from '../lib/supabase';

const supabase = supabaseClient(Astro.cookies);

const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('http://localhost:4321/login');
}
---

<DashboardLayout title="StudyBearer | Dashboard">
  <header class="content-header">
    <h1>Welcome back, <span class="text-neon">Student</span></h1>
    <p>Your next study block starts in 2 hours.</p>
  </header>

  <section class="dashboard-grid">
    <div class="card streak-card">
      <h3>Current Streak</h3>
      <div class="streak-value">5 Days</div>
      <p>Keep it up! 2 more days until next achievement.</p>
    </div>

    <div class="card elo-card">
      <h3>Elo Rating</h3>
      <div class="elo-value">1240 <span class="tier">(Silver)</span></div>
    </div>

    <div class="card pipeline-card">
      <h3>Today's Pipeline</h3>
      <ul class="task-list">
        <li class="task completed">
          <span class="task-time">09:00 AM</span>
          <span class="task-name">Data Structures: Arrays</span>
        </li>
        <li class="task active">
          <span class="task-time">02:00 PM</span>
          <span class="task-name">Data Structures: Linked Lists</span>
          <button class="btn-execute">Execute Module</button>
        </li>
      </ul>
    </div>
  </section>
</DashboardLayout>
