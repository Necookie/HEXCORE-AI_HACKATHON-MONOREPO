---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 — Page Not Found | StudyBearer</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

  <!-- Apply saved theme before first paint to prevent flash -->
  <script is:inline>
    (function () {
      var t = localStorage.getItem('sb-theme');
      if (t === 'light') document.documentElement.dataset.theme = 'light';
    })();
  </script>

  <style>
    .page {
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 32px 24px;
    }

    .mascot {
      width: 160px;
      height: 160px;
      object-fit: contain;
      margin-bottom: 20px;
    }

    .error-code {
      font-family: var(--font-mono);
      font-size: 72px;
      font-weight: 700;
      line-height: 1;
      color: var(--purple);
      margin-bottom: 12px;
      letter-spacing: -0.04em;
    }

    .heading {
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.025em;
      color: var(--text-primary);
      margin: 0 0 8px;
    }

    .subtext {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.6;
      max-width: 280px;
      margin: 0 auto 28px;
    }

    .actions {
      display: flex;
      gap: 8px;
      justify-content: center;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 20px;
      font-family: var(--font-heading);
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      background: var(--purple);
      border: 1.5px solid var(--purple-light);
      border-radius: var(--radius-md);
      cursor: pointer;
      text-decoration: none;
      box-shadow: 0 4px 0 0 #4A2DB0, 0 4px 0 1px #2A1570;
      transition: all 0.1s ease;
    }
    .btn-primary:hover  { background: var(--purple-light); }
    .btn-primary:active { transform: translateY(3px); box-shadow: 0 1px 0 0 #4A2DB0, 0 1px 0 1px #2A1570; }

    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 18px;
      font-family: var(--font-heading);
      font-size: 13px;
      font-weight: 600;
      color: var(--text-secondary);
      background: var(--bg-card);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      cursor: pointer;
      text-decoration: none;
      box-shadow: 0 4px 0 0 #0D1022, 0 4px 0 1px #080A14;
      transition: all 0.1s ease;
    }
    .btn-ghost:hover  { border-color: rgba(123,92,245,0.4); color: var(--text-primary); }
    .btn-ghost:active { transform: translateY(3px); box-shadow: 0 1px 0 0 #0D1022, 0 1px 0 1px #080A14; }

    .hint {
      margin-top: 28px;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--text-muted);
      letter-spacing: 0.06em;
    }
  </style>
</head>

<body>
  <div class="page fade-in">

    <img src="/sb-404.png" alt="StudyBearer panda" class="mascot" />

    <div class="error-code">404</div>

    <h1 class="heading">Off the roadmap</h1>
    <p class="subtext">This page doesn't exist or was moved. Head back and keep executing.</p>

    <div class="actions">
      <a href="/platform/dashboard" class="btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
          <path d="M9 22V12h6v10"/>
        </svg>
        Dashboard
      </a>
      <a href="javascript:history.back()" class="btn-ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        Go back
      </a>
    </div>

    <p class="hint">ERROR · 404 · ROUTE_NOT_FOUND</p>

  </div>
</body>
</html>
