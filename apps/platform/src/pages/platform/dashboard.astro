---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import LearningDashboard from '../../components/LearningDashboard';

const user = Astro.locals.user;
const userName = user?.user_metadata?.full_name ?? user?.email?.split('@')[0] ?? 'Scholar';
---

<PlatformLayout title="Dashboard">
  <LearningDashboard client:load userName={userName} />
</PlatformLayout>
