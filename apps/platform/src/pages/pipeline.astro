---
import Layout from '../layouts/Layout.astro';
import PipelineIngestion from '../components/PipelineIngestion';
import { Network } from 'lucide-react';
---

<Layout title="Pipeline Ingestion">
  <div class="max-w-6xl mx-auto h-full flex flex-col pt-8">
    
    <header class="mb-12 relative">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center border border-primary/20 shadow-[0_0_15px_rgba(99,102,241,0.5)]">
          <Network size={20} className="text-[#6366f1]" />
        </div>
        <div class="h-[1px] flex-1 bg-gradient-to-r from-[#6366f1]/30 to-transparent"></div>
      </div>
      
      <h1 class="text-5xl font-black tracking-tighter text-white mb-2 uppercase">
        Pipeline <span class="text-transparent bg-clip-text bg-gradient-to-b from-white to-[#a1a1aa]">Orchestration</span>
      </h1>
      <p class="text-[#a1a1aa] font-mono text-sm flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#6366f1] animate-pulse"></span>
        AWAITING_INPUT // PREPARE FOR N8N INGESTION
      </p>
    </header>

    <div class="flex-1 flex flex-col justify-center pb-20">
      <PipelineIngestion client:load />
    </div>

  </div>
</Layout>
