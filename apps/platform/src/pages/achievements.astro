---
import Layout from '../layouts/Layout.astro';
import RankLadder from '../components/RankLadder';
import AchievementCard from '../components/AchievementCard';
import { Medal } from 'lucide-react';
---

<Layout title="Achievements">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <header class="mb-12 relative">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center border border-primary/20 shadow-neon">
          <Medal size={20} className="text-primary" />
        </div>
        <div class="h-[1px] flex-1 bg-gradient-to-r from-primary/30 to-transparent"></div>
      </div>
      
      <h1 class="text-5xl font-black tracking-tighter text-white mb-2 uppercase">
        LEGACY <span class="text-gradient">MANIFEST</span>
      </h1>
      <p class="text-muted-steel font-mono text-sm flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        RANK_ELEVATION // ARCHIVE_UNLOCKED: 2
      </p>
    </header>

    <!-- Rank Ladder Island -->
    <section class="mb-20 bg-surface/20 backdrop-blur-md border border-white/5 rounded-3xl p-8">
      <RankLadder client:load />
    </section>

    <!-- Achievement Grid -->
    <section>
      <div class="flex items-center gap-4 mb-10">
        <h2 class="text-sm font-bold uppercase tracking-[0.3em] text-white">Achievement Database</h2>
        <div class="h-[1px] flex-1 bg-white/5"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Unlocked Achievements -->
        <AchievementCard 
          client:load
          title="First Blood" 
          description="Complete your first synchronized study session with 100% focus."
          glowType="neon"
          icon="sword"
        />

        <AchievementCard 
          client:load
          title="Flawless Victory" 
          description="Reach a 7-day streak without missing a single pipeline module."
          glowType="golden"
          icon="flame"
        />

        <!-- Locked Achievements -->
        <AchievementCard 
          client:load
          isLocked={true}
          title="Cognitive Sovereign" 
          description="Achieve Legend rank and maintain a 95% recall accuracy for 30 days."
          icon="trophy"
        />

        <AchievementCard 
          client:load
          isLocked={true}
          title="Deep Work Disciple" 
          description="Log 50 hours of deep work sessions in a single calendar month."
          icon="flame"
        />

        <AchievementCard 
          client:load
          isLocked={true}
          title="Void Runner" 
          description="Complete a 4-hour study session starting after midnight."
          icon="sword"
        />
      </div>
    </section>
  </div>
</Layout>

<style>
  .text-gradient {
    background: linear-gradient(180deg, #ffffff 0%, #a1a1aa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
