---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link href="https://db.onlinewebfonts.com/c/14936bb7a4b6575fd2eee80a3ab52cc2?family=Feather+Bold" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>

  <script>
    // ── Auth guard for landing (client-side, static site) ──────────────────
    import { createClient } from '@supabase/supabase-js';

    const SUPABASE_URL  = import.meta.env.PUBLIC_SUPABASE_URL as string;
    const SUPABASE_KEY  = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;
    const PLATFORM_URL  = (import.meta.env.PUBLIC_PLATFORM_URL as string | undefined)
      ?? (location.hostname === 'localhost' || location.hostname === '127.0.0.1'
          ? 'http://localhost:4322'
          : 'https://app.sb.necookie.dev');

    const params = new URLSearchParams(location.search);

    // ── 1. Just signed out: clear stale localStorage session, clean URL ──
    if (params.get('so') === '1') {
      try {
        const ref = new URL(SUPABASE_URL).hostname.split('.')[0];
        localStorage.removeItem(`sb-${ref}-auth-token`);
        localStorage.removeItem(`sb-${ref}-auth-token-code-verifier`);
      } catch {}
      history.replaceState(null, '', location.pathname);
    }

    // ── 2. Redirected here by platform auth guard (?auth=required) ──
    else if (params.get('auth') === 'required' || params.get('auth') === 'login') {
      const next = params.get('next');
      if (next) sessionStorage.setItem('sb_next', next);

      // Wait for React AuthModal to hydrate, then open it
      const openModal = () =>
        window.dispatchEvent(new CustomEvent('open-auth', { detail: { mode: 'login' } }));

      if (document.readyState === 'complete') {
        setTimeout(openModal, 120);
      } else {
        window.addEventListener('load', () => setTimeout(openModal, 120));
      }
    }

    // ── 3. Already logged in → send to platform ──────────────────────────
    else if (location.pathname === '/') {
      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        location.replace(`${PLATFORM_URL}/platform`);
      }
    }
  </script>
</html>
