---
---

<section id="ranks" class="section ranks-section">
      <div class="section-label">Progression System</div>
      <h2 class="section-title">
        Climb the <span class="grad-text">Ladder</span>
      </h2>
      <p class="section-sub">
        Eight competitive tiers. Each rank unlocks new cosmetics and achievement
        titles. Mythic is reserved for the relentless.
      </p>

      <div class="ranks-grid">
        <div class="rank-card" style="--rank-clr:#71717a">
          <span class="rank-tier-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
          </span>
          <span class="rank-name">Iron</span>
          <span class="rank-desc">Beginning the pipeline</span>
        </div>
        <div class="rank-card" style="--rank-clr:#b45309">
          <span class="rank-tier-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </span>
          <span class="rank-name">Bronze</span>
          <span class="rank-desc">First combos ignited</span>
        </div>
        <div class="rank-card" style="--rank-clr:#9ca3af">
          <span class="rank-tier-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </span>
          <span class="rank-name">Silver</span>
          <span class="rank-desc">Consistent execution</span>
        </div>
        <div class="rank-card" style="--rank-clr:#d97706">
          <span class="rank-tier-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          </span>
          <span class="rank-name">Gold</span>
          <span class="rank-desc">Mastery emerging</span>
        </div>
        <div class="rank-card" style="--rank-clr:var(--purple)">
          <span class="rank-tier-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </span>
          <span class="rank-name">Elite</span>
          <span class="rank-desc">Peak pipeline discipline</span>
        </div>
        <div class="rank-card" style="--rank-clr:var(--purple-light)">
          <span class="rank-tier-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg>
          </span>
          <span class="rank-name">Master</span>
          <span class="rank-desc">Flawless streaks</span>
        </div>
        <div class="rank-card" style="--rank-clr:#a855f7">
          <span class="rank-tier-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/></svg>
          </span>
          <span class="rank-name">Legend</span>
          <span class="rank-desc">Untouchable accuracy</span>
        </div>
        <div class="rank-card rank-mythic" style="--rank-clr:#e879f9">
          <span class="rank-tier-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7z"/></svg>
          </span>
          <span class="rank-name">Mythic</span>
          <span class="rank-desc">The relentless few</span>
        </div>
      </div>

      <div class="achievements-row">
        <div class="section-label" style="margin-bottom:1.25rem;">
          Achievement Titles
        </div>
        <div class="achievement-tags">
          <span class="ach-tag">First Blood</span>
          <span class="ach-tag">Flawless Victory</span>
          <span class="ach-tag">7-Day Inferno</span>
          <span class="ach-tag">Perfect Recall</span>
          <span class="ach-tag">Speed Runner</span>
          <span class="ach-tag">Night Owl</span>
          <span class="ach-tag">No-Miss Month</span>
          <span class="ach-tag ach-locked">??? Mythic Secret</span>
        </div>
      </div>
    </section>

<style>
/* ── RANKS ── */
  .ranks-section {
    border-top: 1px solid var(--border);
  }

  .ranks-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .rank-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.25rem 1rem;
    text-align: center;
    cursor: default;
    transition:
      border-color 0.3s,
      transform 0.3s,
      opacity 0.4s;
    opacity: 0;
    transform: translateY(16px);
  }

  .rank-card.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .rank-card:hover {
    border-color: var(--rank-clr);
    transform: translateY(-3px);
  }

  .rank-tier-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.5rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(from var(--rank-clr) r g b / 0.1);
    color: var(--rank-clr);
  }

  .rank-name {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--rank-clr);
    margin-bottom: 0.25rem;
  }
  .rank-desc {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .rank-mythic {
    background: linear-gradient(
      135deg,
      rgba(168, 85, 247, 0.08),
      rgba(123, 92, 245, 0.08)
    );
    border-color: rgba(168, 85, 247, 0.3);
  }

  .achievements-row {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }

  .achievement-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ach-tag {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--surface);
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .ach-tag:hover {
    border-color: rgba(123, 92, 245, 0.4);
    color: var(--text);
  }

  .ach-locked {
    opacity: 0.4;
    border-style: dashed;
  }

  @media (max-width: 480px) {
    .ranks-grid { grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
    .rank-card { padding: 1rem 0.75rem; }
    .rank-tier-icon { width: 30px; height: 30px; }
    .rank-name { font-size: 0.82rem; }
    .rank-desc { font-size: 0.68rem; }
    .ach-tag { padding: 0.35rem 0.7rem; font-size: 0.75rem; }
    .achievements-row { padding-top: 1.5rem; }
  }

  @media (max-width: 360px) {
    .ranks-grid { grid-template-columns: 1fr; }
  }
</style>
