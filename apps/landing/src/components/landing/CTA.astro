<section class="cta-section">
      <div class="cta-content">
        <div class="section-label">Ready to Execute?</div>
        <h2 class="cta-title">
          We organize your life.<br />Schedule your week.<br /><span
            class="grad-text">Quiz you while you sleep.</span>
        </h2>
        <p class="cta-sub">
          Initialize your first pipeline in under 60 seconds. Drop a PDF and
          watch the system take over.
        </p>
        <div class="cta-actions">
          <a href="#" class="btn-primary btn-lg auth-trigger" data-mode="signup">
            Deploy Now
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <div class="terminal-mockup">
            <div class="terminal-header"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
            <pre><code>npm install studybearer@latest</code></pre>
          </div>
        </div>
        <div class="cta-secondary">
          <a href="#" class="btn-ghost btn-lg auth-trigger" data-mode="login">Already deployed? Sign In</a>
        </div>
      </div>
    </section>

<style>
/* ── CTA ── */
  .cta-section {
    position: relative;
    border-top: 1px solid var(--border);
    text-align: center;
    padding: clamp(5rem, 10vw, 9rem) 1.5rem;
    overflow: hidden;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 1.25rem;
  }

  .cta-sub {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>