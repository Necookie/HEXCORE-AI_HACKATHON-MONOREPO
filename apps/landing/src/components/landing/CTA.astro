---
---

<section class="cta-section">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-content">
        <div class="section-label">Ready to Execute?</div>
        <h2 class="cta-title">
          We organize your life.<br />Schedule your week.<br /><span
            class="grad-text">Quiz you while you sleep.</span>
        </h2>
        <p class="cta-sub">
          Initialize your first pipeline in under 60 seconds. Drop a PDF and
          watch the system take over.
        </p>
        <div class="cta-actions">
          <a href="/signup" class="btn-primary btn-lg">
            Deploy Your Pipeline
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </a>
          <a href="/login" class="btn-ghost btn-lg">Already deployed? Sign In</a
          >
        </div>
      </div>
    </section>

<style>
/* ── CTA ── */
  .cta-section {
    position: relative;
    border-top: 1px solid var(--border);
    text-align: center;
    padding: clamp(5rem, 10vw, 9rem) 1.5rem;
    overflow: hidden;
  }

  .cta-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(
      ellipse,
      rgba(99, 102, 241, 0.18) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-title {
    font-family: "Syne", sans-serif;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 1.25rem;
  }

  .cta-sub {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>