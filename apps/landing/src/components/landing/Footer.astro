<footer class="footer">
      <div class="footer-logo">
        <svg
          width="20"
          height="20"
          viewBox="0 0 28 28"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <circle cx="14" cy="14" r="5" stroke="#6366f1" stroke-width="1.5"
          ></circle>
          <path
            d="M14 2C14 2 22 6 22 14C22 22 14 26 14 26"
            stroke="#6366f1"
            stroke-width="1.5"
            stroke-linecap="round"></path>
          <path
            d="M14 2C14 2 6 6 6 14C6 22 14 26 14 26"
            stroke="#8b5cf6"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        <span>StudyBearer</span>
      </div>
      <p class="footer-tagline">Automating the friction of studying.</p>
      <div class="footer-links">
        <a href="#" class="auth-trigger" data-mode="login">Sign In</a>
        <a href="#" class="auth-trigger" data-mode="signup">Sign Up</a>
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
      </div>
      <p class="footer-copy">
        © 2026 StudyBearer · iSITE AI Hackathon · Built with n8n, Astro, and
        Supabase
      </p>
    </footer>

<style>
/* ── FOOTER ── */
  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Syne", sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .footer-tagline {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.8rem;
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: var(--text);
  }

  .footer-copy {
    color: #52525b;
    font-size: 0.75rem;
  }
</style>