---
---

<header class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-lines"></div>
  </div>

  <div class="hero-badge">
    <span class="badge-dot"></span>
    iSITE AI Hackathon 2026 · n8n Powered
  </div>

  <h1 class="hero-title">
    Stop <em>planning</em> to study.<br />
    <span class="grad-text">Start executing.</span>
  </h1>

  <p class="hero-subtitle">
    Eliminate the cognitive load of organizing notes, generating flashcards, and finding optimal study paths. Just drag, drop, and deploy your knowledge.
  </p>

  <div class="hero-actions">
    <a href="#" class="btn-primary btn-lg auth-trigger" data-mode="signup">
      Sign Up
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
    <a href="#pipeline" class="btn-ghost btn-lg">View the Pipeline</a>
  </div>

  <div class="hero-stats">
    <div class="stat">
      <span class="stat-num">&lt; 30s</span>
      <span class="stat-label">PDF → Calendar</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat">
      <span class="stat-num">3 modes</span>
      <span class="stat-label">MCQ · Enum · ID</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat">
      <span class="stat-num">5 Tiers</span>
      <span class="stat-label">Cub → Spirit Bear</span>
    </div>
  </div>

</header>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 1.5rem 2.5rem;
    overflow: hidden;
  }

  .hero-bg { position: absolute; inset: 0; pointer-events: none; }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(123, 92, 245, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(123, 92, 245, 0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 30%, transparent 100%);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid rgba(123, 92, 245, 0.3);
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--purple);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    background: rgba(123, 92, 245, 0.06);
    animation: fadeUp 0.6s ease both;
  }

  .badge-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--purple);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.6); }
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    animation: fadeUp 0.6s 0.1s ease both;
  }

  .hero-title em { font-style: normal; color: var(--text-secondary); }

  .grad-text {
    background: linear-gradient(135deg, #fff 0%, var(--purple) 50%, var(--purple-light) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    max-width: 520px;
    color: var(--text-secondary);
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    line-height: 1.65;
    margin-bottom: 1.75rem;
    animation: fadeUp 0.6s 0.2s ease both;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 2rem;
    animation: fadeUp 0.6s 0.3s ease both;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
    animation: fadeUp 0.6s 0.4s ease both;
    flex-wrap: wrap;
    justify-content: center;
  }

  .stat { text-align: center; }
  .stat-num {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--purple-light);
  }
  .stat-label { font-size: 0.7rem; color: var(--text-secondary); letter-spacing: 0.04em; }
  .stat-divider { width: 1px; height: 28px; background: var(--border); }

  @media (max-width: 720px) {
    .hero { padding: 4rem 1.25rem 2rem; }
    .hero-title { font-size: clamp(1.8rem, 8vw, 3rem); }
    .hero-subtitle { font-size: 0.9rem; margin-bottom: 1.5rem; }
    .hero-actions { margin-bottom: 1.5rem; }
    .hero-stats { gap: 1rem; margin-bottom: 0; }
  }

  @media (max-width: 480px) {
    .hero { min-height: unset; padding: 5rem 1.25rem 2.5rem; }
    .hero-title { font-size: clamp(1.6rem, 9vw, 2.4rem); }
    .hero-badge { font-size: 0.68rem; padding: 0.3rem 0.75rem; }
    .hero-actions { flex-direction: column; align-items: stretch; width: 100%; max-width: 320px; }
    .hero-actions a { justify-content: center; }
    .stat-num { font-size: 1.1rem; }
  }

</style>
