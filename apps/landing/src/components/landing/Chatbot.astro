---
/**
 * Chatbot.astro
 * Floating chatbot component. 
 * Logic: src/lib/chatbot.ts
 * Styles: src/styles/chatbot.css
 */
import "../../styles/chatbot.css";
---

<div id="chatbot-container" class="chatbot-wrapper">
  <!-- Chat Window -->
  <div id="chat-window" class="chat-window hidden">
    <div class="chat-header">
      <div class="chat-title">
        <span class="pulse-dot"></span>
        StudyBearer AI
      </div>
      <button id="close-chat" class="close-btn" aria-label="Close chat">✕</button>
    </div>

    <div id="chat-messages" class="chat-messages">
      <div class="message bot-message">
        <div class="msg-content">
          Hello! I'm the StudyBearer AI assistant. How can I help you accelerate
          your learning today?
        </div>
      </div>
    </div>

    <form id="chat-form" class="chat-input-area">
      <input
        type="text"
        id="chat-input"
        placeholder="Type a message..."
        required
        autocomplete="off"
      />
      <button type="submit" class="send-btn" aria-label="Send message">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="22" y1="2" x2="11" y2="13"></line><polygon
            points="22 2 15 22 11 13 2 9 22 2"></polygon></svg
        >
      </button>
    </form>
  </div>

  <!-- Chat Toggle Button -->
  <button id="chat-toggle" class="chat-toggle-btn" aria-label="Toggle chat">
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>
</div>

<script>
  // Import the chatbot logic
  import "../../lib/chatbot";
</script>
