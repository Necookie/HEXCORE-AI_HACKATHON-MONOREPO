---
// Chatbot.astro
// Floating chatbot component using Vanilla JS to communicate with the n8n webhook.
---

<div id="chatbot-container" class="chatbot-wrapper">
  <!-- Chat Window -->
  <div id="chat-window" class="chat-window hidden">
    <div class="chat-header">
      <div class="chat-title">
        <span class="pulse-dot"></span>
        StudyBearer AI
      </div>
      <button id="close-chat" class="close-btn" aria-label="Close chat"
        >✕</button
      >
    </div>

    <div id="chat-messages" class="chat-messages">
      <div class="message bot-message">
        <div class="msg-content">
          Hello! I'm the StudyBearer AI assistant. How can I help you accelerate
          your learning today?
        </div>
      </div>
    </div>

    <form id="chat-form" class="chat-input-area">
      <input
        type="text"
        id="chat-input"
        placeholder="Type a message..."
        required
        autocomplete="off"
      />
      <button type="submit" class="send-btn" aria-label="Send message">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="22" y1="2" x2="11" y2="13"></line><polygon
            points="22 2 15 22 11 13 2 9 22 2"></polygon></svg
        >
      </button>
    </form>
  </div>

  <!-- Chat Toggle Button -->
  <button id="chat-toggle" class="chat-toggle-btn" aria-label="Toggle chat">
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
      ></path>
    </svg>
  </button>
</div>

<script>
  // Chatbot Logic
  document.addEventListener("DOMContentLoaded", () => {
    const chatToggle = document.getElementById("chat-toggle");
    const chatWindow = document.getElementById("chat-window");
    const closeChat = document.getElementById("close-chat");
    const chatForm = document.getElementById("chat-form");
    const chatInput = document.getElementById("chat-input") as HTMLInputElement;
    const chatMessages = document.getElementById("chat-messages");

    // Toggle chat window
    const toggleChat = () => {
      chatWindow?.classList.toggle("hidden");
      if (!chatWindow?.classList.contains("hidden")) {
        chatInput?.focus();
      }
    };

    chatToggle?.addEventListener("click", toggleChat);
    closeChat?.addEventListener("click", toggleChat);

    // Add message to UI
    const addMessage = (text: string, isUser: boolean) => {
      if (!chatMessages) return;
      
      const msgDiv = document.createElement("div");
      msgDiv.className = `message ${isUser ? "user-message" : "bot-message"}`;

      const contentDiv = document.createElement("div");
      contentDiv.className = "msg-content";
      
      // Use innerHTML to support markdown-like bolding if needed, but for now textContent is safer
      // Unless we want to support the emoji in the screenshot
      contentDiv.textContent = text;

      msgDiv.appendChild(contentDiv);
      chatMessages.appendChild(msgDiv);
      
      // Ensure it scrolls to bottom
      chatMessages.scrollTop = chatMessages.scrollHeight;
    };

    // Show loading state
    const showTyping = () => {
      if (!chatMessages) return null;
      const msgDiv = document.createElement("div");
      msgDiv.className = "message bot-message typing-indicator-container";
      msgDiv.id = "typing-indicator";

      const contentDiv = document.createElement("div");
      contentDiv.className = "msg-content typing-indicator";
      contentDiv.innerHTML = "<span></span><span></span><span></span>";

      msgDiv.appendChild(contentDiv);
      chatMessages.appendChild(msgDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
      return msgDiv;
    };

    // Remove loading state
    const removeTyping = (element: HTMLElement | null) => {
      if (element && element.parentNode) {
        element.parentNode.removeChild(element);
      }
    };

    // Handle form submission
    chatForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const text = chatInput.value.trim();
      if (!text) return;

      // Add user message
      addMessage(text, true);
      chatInput.value = "";

      // Add typing indicator
      const typingEl = showTyping();

      try {
        // Send to n8n webhook
        // Note: Astro injects public env vars via import.meta.env
        // We trim just in case of spaces in the .env file
        const webhookUrl = import.meta.env.PUBLIC_N8N_CHAT_WEBHOOK_URL?.trim();

        if (!webhookUrl) {
          throw new Error("Webhook URL not configured");
        }

        const response = await fetch(webhookUrl, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            action: "sendMessage",
            sessionId:
              localStorage.getItem("sb_chat_session") || crypto.randomUUID(),
            chatInput: text,
          }),
        });

        // Store session ID if generated
        if (!localStorage.getItem("sb_chat_session")) {
          const sessionData = JSON.parse(
            response.headers.get("session-data") || "{}",
          );
          if (sessionData.id)
            localStorage.setItem("sb_chat_session", sessionData.id);
        }

        // Try to parse response or error message
        let botResponseText = "Sorry, I received an invalid response.";
        const contentType = response.headers.get("content-type");
        
        if (contentType && contentType.includes("application/json")) {
          const data = await response.json();
          botResponseText = data.output || data.message || data.response || JSON.stringify(data);
        } else {
          botResponseText = await response.text();
        }

        if (!response.ok) {
          throw new Error(botResponseText || `Server error (${response.status})`);
        }

        removeTyping(typingEl);
        addMessage(botResponseText, false);
      } catch (error) {
        console.error("Chat error:", error);
        removeTyping(typingEl);
        addMessage(
          `Error: ${error.message || "Please try again."}`,
          false,
        );
      }
    });
  });
</script>

<style is:global>
  .chatbot-wrapper {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 9999;
    font-family: "Inter", "Syne", sans-serif;
  }

  .chat-toggle-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      var(--indigo, #6366f1),
      var(--violet, #8b5cf6)
    );
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(99, 102, 241, 0.4);
    transition:
      transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      box-shadow 0.3s ease;
  }

  .chat-toggle-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 12px 32px rgba(99, 102, 241, 0.6);
  }

  .chat-window {
    position: absolute;
    bottom: 80px;
    right: 0;
    width: 360px;
    height: 500px;
    max-height: calc(100vh - 120px);
    background: var(--surface, #121216);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.07));
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(99, 102, 241, 0.1);
    transform-origin: bottom right;
    transition:
      opacity 0.3s ease,
      transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    opacity: 1;
    transform: scale(1);
  }

  .chat-window.hidden {
    opacity: 0;
    transform: scale(0.8);
    pointer-events: none;
  }

  .chat-header {
    padding: 1rem 1.25rem;
    background: rgba(10, 10, 12, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border, rgba(255, 255, 255, 0.07));
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .chat-title {
    font-family: "Syne", sans-serif;
    font-weight: 700;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text, #f4f4f5);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #a3e635;
    box-shadow: 0 0 8px #a3e635;
    animation: pulse-dot-anim 2s infinite;
  }

  @keyframes pulse-dot-anim {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  .close-btn {
    background: transparent;
    border: none;
    color: var(--muted, #a1a1aa);
    cursor: pointer;
    font-size: 1.2rem;
    transition: color 0.2s;
  }

  .close-btn:hover {
    color: var(--text, #f4f4f5);
  }

  .chat-messages {
    flex: 1;
    padding: 1.25rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: rgba(0, 0, 0, 0.2);
  }

  .message {
    display: flex;
    width: 100%;
    margin-bottom: 0.25rem;
    animation: message-appear 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes message-appear {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .user-message {
    justify-content: flex-end;
  }

  .bot-message {
    justify-content: flex-start;
  }

  .msg-content {
    padding: 0.75rem 1.1rem;
    max-width: 80%;
    font-size: 0.925rem;
    line-height: 1.5;
    position: relative;
    border-radius: 1.2rem;
    word-wrap: break-word;
  }

  /* User bubble tail — bottom-right */
  .user-message .msg-content {
    background: #6366f1;
    color: white;
    border-bottom-right-radius: 4px;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.2);
  }

  .user-message .msg-content::before {
    content: "";
    position: absolute;
    bottom: 0;
    right: -9px;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 12px 0 0 10px;
    border-color: transparent transparent transparent #6366f1;
  }

  /* Bot bubble tail — bottom-left */
  .bot-message .msg-content {
    background: #27272a;
    color: #f4f4f5;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-left-radius: 4px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .bot-message .msg-content::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: -9px;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 12px 10px 0 0;
    border-color: transparent #27272a transparent transparent;
  }

  /* Typing indicator specific styling to ensure it looks like a bubble */
  .bot-message.typing-indicator-container .msg-content {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 60px;
    min-height: 40px;
  }

  .chat-input-area {
    padding: 1rem;
    background: var(--surface, #121216);
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.07));
    display: flex;
    gap: 0.5rem;
  }

  #chat-input {
    flex: 1;
    background: var(--surface-2, #18181e);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.07));
    color: var(--text, #f4f4f5);
    padding: 0.75rem 1rem;
    border-radius: 2rem;
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.2s;
  }

  #chat-input:focus {
    border-color: var(--indigo, #6366f1);
  }

  .send-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--indigo, #6366f1);
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s;
  }

  .send-btn:hover {
    background: #5254d4;
  }

  /* Typing indicator */
  .typing-indicator span {
    display: inline-block;
    width: 6px;
    height: 6px;
    background-color: var(--muted, #a1a1aa);
    border-radius: 50%;
    margin: 0 2px;
    animation: typing 1.4s infinite ease-in-out both;
  }

  .typing-indicator span:nth-child(1) {
    animation-delay: -0.32s;
  }
  .typing-indicator span:nth-child(2) {
    animation-delay: -0.16s;
  }

  @keyframes typing {
    0%,
    80%,
    100% {
      transform: scale(0);
    }
    40% {
      transform: scale(1);
    }
  }

  @media (max-width: 480px) {
    .chatbot-wrapper {
      bottom: 1rem;
      right: 1rem;
    }
    .chat-window {
      width: calc(100vw - 2rem);
      height: 60vh;
    }
  }
</style>
