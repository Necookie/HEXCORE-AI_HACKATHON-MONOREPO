---
---

<nav class="navbar" id="navbar">
  <a href="/" class="logo" aria-label="StudyBearer home">
    <img src="/sb_symbol_blk.png" width="32" height="32" alt="" aria-hidden="true" style="filter:invert(1);object-fit:contain;" />
    <span>StudyBearer</span>
  </a>
  <div class="nav-links">
    <a href="#features">Features</a>
    <a href="#pipeline">Pipeline</a>
    <a href="#ranks">Ranks</a>
    <a href="#stack">Stack</a>
  </div>
  <div class="nav-cta">
    <a href="#" class="nav-signin auth-trigger" data-mode="login">Sign In</a>
    <a href="#" class="btn-primary auth-trigger" data-mode="signup">Sign Up</a>
  </div>
  <button class="nav-hamburger no-3d" id="navHamburger" aria-label="Toggle menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- Full-page mobile menu overlay -->
<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <div class="mobile-menu-inner">

    <!-- Brand header -->
    <div class="mm-brand">
      <img src="/sb_symbol_blk.png" width="40" height="40" alt="" aria-hidden="true" style="filter:invert(1);object-fit:contain;" />
      <div>
        <div class="mm-brand-name">StudyBearer</div>
        <div class="mm-brand-tagline">Stop planning. Start executing.</div>
      </div>
    </div>

    <div class="mm-divider"></div>

    <!-- Nav links -->
    <nav class="mm-nav" aria-label="Mobile navigation">
      <a href="#features" class="mm-link mm-close-trigger">
        <span class="mm-link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
        </span>
        Features
        <svg class="mm-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="#pipeline" class="mm-link mm-close-trigger">
        <span class="mm-link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><circle cx="5" cy="12" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="19" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
        </span>
        Pipeline
        <svg class="mm-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="#ranks" class="mm-link mm-close-trigger">
        <span class="mm-link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg>
        </span>
        Ranks
        <svg class="mm-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="#stack" class="mm-link mm-close-trigger">
        <span class="mm-link-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M8 8V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3"/><path d="M2 14h20"/></svg>
        </span>
        Stack
        <svg class="mm-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </nav>

    <div class="mm-divider"></div>

    <!-- Auth buttons -->
    <div class="mm-auth">
      <a href="#" class="mm-btn-signup btn-primary auth-trigger" data-mode="signup">
        Sign Up — It's Free
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="#" class="mm-btn-signin auth-trigger" data-mode="login">
        Already have an account? <strong>Sign In</strong>
      </a>
    </div>

    <!-- Bottom tagline -->
    <div class="mm-footer">
      <span>iSITE AI Hackathon 2026 · n8n Powered</span>
    </div>

  </div>
</div>

<script>
  const navbar  = document.getElementById('navbar');
  const ham     = document.getElementById('navHamburger') as HTMLButtonElement | null;
  const menu    = document.getElementById('mobileMenu');

  // Scroll: frosted navbar
  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('scrolled', window.scrollY > 40);
  });

  function openMenu() {
    menu?.classList.add('open');
    ham?.classList.add('active');
    ham?.setAttribute('aria-expanded', 'true');
    menu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.remove('open');
    ham?.classList.remove('active');
    ham?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  ham?.addEventListener('click', () => {
    menu?.classList.contains('open') ? closeMenu() : openMenu();
  });

  // Close on any anchor link inside the menu
  menu?.querySelectorAll('.mm-close-trigger').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close on backdrop click (clicking outside mm-inner)
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) closeMenu();
  });

  // Auth triggers — open modal and close menu
  document.querySelectorAll('.auth-trigger').forEach(trigger => {
    trigger.addEventListener('click', (e) => {
      e.preventDefault();
      const mode = (e.currentTarget as HTMLElement).getAttribute('data-mode') || 'login';
      window.dispatchEvent(new CustomEvent('open-auth', { detail: { mode } }));
      closeMenu();
    });
  });
</script>

<style>
/* ── NAVBAR ── */
  .navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
  }

  .navbar.scrolled {
    background: rgba(11, 13, 20, 0.88);
    backdrop-filter: blur(16px);
    border-color: var(--border);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
    position: relative;
    z-index: 210;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--text-primary); }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-signin {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav-signin:hover { color: var(--text-primary); }

  /* Hamburger */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0.45rem 0.5rem;
    position: relative;
    z-index: 210;
    width: 38px;
    height: 38px;
  }

  .nav-hamburger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-secondary);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease, background 0.25s;
    transform-origin: center;
  }

  .nav-hamburger.active span { background: var(--text-primary); }
  .nav-hamburger.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-hamburger.active span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .nav-hamburger.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ── FULL-PAGE MOBILE MENU ── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 190;
    background: var(--bg-base);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 6rem 1.75rem 2.5rem;
    overflow-y: auto;
  }

  /* Brand block */
  .mm-brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .mm-brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--text-primary);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .mm-brand-tagline {
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin-top: 0.1rem;
  }

  .mm-divider {
    height: 1px;
    background: var(--border);
    margin-bottom: 1.5rem;
  }

  /* Nav links */
  .mm-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
  }

  .mm-link {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    color: var(--text-secondary);
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }

  .mm-link:hover, .mm-link:active {
    color: var(--text-primary);
    background: var(--bg-elevated);
    border-color: var(--border);
  }

  .mm-link-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(123, 92, 245, 0.1);
    border: 1px solid rgba(123, 92, 245, 0.15);
    color: var(--purple-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mm-arrow {
    margin-left: auto;
    color: var(--text-muted);
    transition: transform 0.2s, color 0.2s;
  }
  .mm-link:hover .mm-arrow { transform: translateX(3px); color: var(--purple-light); }

  /* Auth section */
  .mm-auth {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .mm-btn-signup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .mm-btn-signin {
    text-align: center;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    padding: 0.5rem;
    transition: color 0.2s;
  }
  .mm-btn-signin strong { color: var(--purple-light); font-weight: 600; }
  .mm-btn-signin:hover { color: var(--text-primary); }

  /* Footer tagline */
  .mm-footer {
    margin-top: auto;
    padding-top: 1rem;
    text-align: center;
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-top: 1px solid var(--border);
  }

  /* ── BREAKPOINTS ── */
  @media (min-width: 721px) {
    .nav-hamburger { display: none !important; }
    .mobile-menu { display: none !important; }
  }

  @media (max-width: 720px) {
    .nav-links, .nav-cta { display: none; }
    .nav-hamburger { display: flex; }
  }

  @media (max-width: 480px) {
    .navbar { padding: 0.75rem 1.25rem; }
    .logo { font-size: 0.95rem; }
    .logo img { width: 26px; height: 26px; }
    .mobile-menu-inner { padding: 5.5rem 1.25rem 2rem; }
    .mm-link { font-size: 1rem; padding: 0.8rem 0.875rem; }
  }
</style>
